# TasteQuest server configuration. Copy to .env (or run `npm run setup`, which
# generates random secrets for you). Never commit .env.

# Interface to listen on. 0.0.0.0 = reachable from the ESP8266 and other LAN devices.
HOST=0.0.0.0
PORT=3000

# SQLite file (relative to the repo root, or absolute).
DB_PATH=data/tastequest.db

# Initial dashboard display mode until an operator changes it: DEMO or LIVE.
APP_MODE=DEMO

# Operator dashboard password (min. 8 chars).
OPERATOR_PASSWORD=change-me-operator

# Shared secret the ESP8266 sends as "Authorization: Bearer <token>" (min. 16 chars).
# Must match DEVICE_API_TOKEN in firmware/include/secrets.h.
DEVICE_TOKEN=change-me-device-token

# A device is shown offline after this much silence (ms).
DEVICE_OFFLINE_MS=15000
# Temperature/humidity history is written to SQLite at most this often (ms).
TELEMETRY_PERSIST_MS=60000
# Operator login lifetime (hours).
SESSION_TTL_HOURS=12

# Optional, frontend only. Leave empty so the dashboard uses the same origin as
# the server (recommended; required for operator login cookies).
VITE_API_URL=
VITE_SOCKET_URL=
